# COPY TO .env. Never commit .env or your credentials. Every value must be independent.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
# Inbound tokens: orchestrator -> each agent runner (>= 24 chars, one per agent)
AGENT_TOKEN_CLAUDE_1=REPLACE_WITH_LONG_RANDOM_VALUE
AGENT_TOKEN_CLAUDE_2=REPLACE_WITH_LONG_RANDOM_VALUE
AGENT_TOKEN_CODEX=REPLACE_WITH_LONG_RANDOM_VALUE
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# 'demo' -> real agents are NOT invoked; deterministic local planning
# 'cli'  -> runs the Claude / Codex CLIs; log in to each account first (docs/deployment.md)
AGENT_MODE=demo
# Hostnames each agent's egress proxy may CONNECT to (port 443 only). Defaults are in
# compose.yaml; verify against the pinned CLI versions before AGENT_MODE=cli.
# EGRESS_ALLOW_ANTHROPIC=api.anthropic.com,platform.claude.com
# EGRESS_ALLOW_OPENAI=api.openai.com,auth.openai.com,chatgpt.com
# PRODUCTION (required: remote-deploy.sh refuses without it): host ip:port pairs, comma-separated,
# that no container may be able to reach (the tailnet IP on 22 and 8000 at least). The proxies
# report unhealthy and, together with api/discovery/telegram, refuse to START while one answers
# (connected or refused). Leave empty only in development/CI. See docs/deployment.md.
EGRESS_FORBIDDEN_TARGETS=
SCAN_CRON=0 7,13,20 * * *
TZ=Europe/Zurich

# DNS resolver of every service with a route out (api, discovery, telegram, the three egress
# proxies). It MUST be the resolver host-egress-guard.conf allows (DNS=). slirp4netns: 10.0.2.3.
# On a rootful development machine set one that exists there, e.g. HUNTER_DNS=1.1.1.1.
# (docs/deployment.md, "DNS"; deploy/check-dns.sh verifies it, and remote-deploy.sh refuses a release
# whose rendered DNS differs from DNS= BEFORE starting anything; an SSH caller's HUNTER_DNS is ignored)
#HUNTER_DNS=10.0.2.3
