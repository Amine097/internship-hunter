# COPY TO .env. Never commit .env or your credentials. Every value must be independent.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
# Inbound tokens: orchestrator -> each agent runner (>= 24 chars, one per agent)
AGENT_TOKEN_CLAUDE_1=REPLACE_WITH_LONG_RANDOM_VALUE
AGENT_TOKEN_CLAUDE_2=REPLACE_WITH_LONG_RANDOM_VALUE
AGENT_TOKEN_CODEX=REPLACE_WITH_LONG_RANDOM_VALUE
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# 'demo' -> real agents are NOT invoked; deterministic local planning
# 'cli'  -> runs the Claude / Codex CLIs; log in to each account first (docs/deployment.md)
AGENT_MODE=demo
# Hostnames each agent's egress proxy may CONNECT to (port 443 only). Defaults are in
# compose.yaml; verify against the pinned CLI versions before AGENT_MODE=cli.
# EGRESS_ALLOW_ANTHROPIC=api.anthropic.com,console.anthropic.com,claude.ai,statsig.anthropic.com
# EGRESS_ALLOW_OPENAI=api.openai.com,auth.openai.com,chatgpt.com
SCAN_CRON=0 7,13,20 * * *
TZ=Europe/Zurich
