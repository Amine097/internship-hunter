# COPY TO .env. Never commit .env or your credentials.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
ADMIN_TOKEN=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
AGENT_MODE=demo
# 'demo' -> real agents are NOT invoked; independent deterministic planning
# 'cli' -> runs local Claude / Codex CLI; login to each account first
ENABLE_FIXTURES=false
SCAN_CRON=0 7,13,20 * * *
TZ=Europe/Zurich
