# COPY TO .env. Never commit .env or your credentials.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE
ADMIN_TOKEN=REPLACE_WITH_A_THIRD_LONG_RANDOM_VALUE
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# 'demo' -> real agents are NOT invoked; deterministic local planning
# 'cli'  -> runs the Claude / Codex CLIs; log in to each account first (see docs/deployment.md)
AGENT_MODE=demo
SCAN_CRON=0 7,13,20 * * *
TZ=Europe/Zurich
