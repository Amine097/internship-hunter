# After a host reboot: if a session was active when the machine went down, restore the
# containers it had stopped (containers with restart=unless-stopped stay down otherwise).
[Unit]
Description=Internship Hunter RSM boot recovery
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=hunter-rsm
Group=hunter-rsm
SupplementaryGroups=docker
Environment=PYTHONPATH=/opt/hunter-rsm/src PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m hunter.rsm recover \
  --policy /etc/hunter-rsm/policy.json --state-dir /var/lib/hunter-rsm
TimeoutStartSec=900
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/hunter-rsm
ReadOnlyPaths=/etc/hunter-rsm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
